    }

    public fun toLocAnim(loc: LocInfo, seq: Int): ZoneProt {
        val zoneGrid = ZoneGrid.from(loc.coords)
        return LocAnim(seq, zoneGrid.x, zoneGrid.z, loc.shapeId, loc.angleId)
    }

